{
  "name": "dfl-gestion-agents",
  "version": "3.9.0",
  "description": "Gestion des agents - Direction de Suivi des Finances Locales",
  "main": "main.js",
  "author": "Elia Kilu Honore",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "prepare-assets": "node prepare.js",
    "dist": "npm run prepare-assets && node protect.js index.html && electron-builder --win nsis --x64 --ia32 --publish never"
  },
  "build": {
    "appId": "cd.dfl.gestionagents",
    "productName": "DFL Gestion des agents",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "fonts/**/*",
      "lib/**/*",
      "icon.png",
      "icon.ico",
      "LICENSE.txt"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DFL Gestion des agents",
      "language": "1036",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "artifactName": "DFL-Setup-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "@fontsource-variable/montserrat": "^5.1.0",
    "xlsx": "0.18.5",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "3.11.174",
    "javascript-obfuscator": "4.1.1"
  }
}